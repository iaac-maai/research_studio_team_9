    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ExportThermalSchedule.png" />
    <None Remove="InspectElement.png" />
    <None Remove="products.json" />
    <None Remove="project_requirements.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ExportThermalSchedule.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="InspectElement.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
